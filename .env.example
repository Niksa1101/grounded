# Grounded configuration. Copy to `.env` (repo root) and uncomment only what you need.
# Every variable is read by backend/src/grounded/settings.py (see docs/Tech.md §4); keep this file in sync.
# Never put real values here. Commented values are the code defaults, shown for reference.
# An uncommented empty line (`FOO=`) is NOT "unset": it is an empty string and may fail validation.

# --- App --------------------------------------------------------------------------------------
# APP_ENV=dev                      # dev | test | prod | eval
# LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Database ---------------------------------------------------------------------------------
# Defaults point at infra/docker-compose.yml (localhost:5433). Prod must set DATABASE_URL explicitly.
# DATABASE_URL=                    # runtime (pooled Neon URL, app role, in prod)
# DATABASE_URL_DIRECT=             # owner URL for migrate/ingest/retention; falls back to DATABASE_URL
# TEST_DATABASE_URL=               # local only; pytest refuses non-local hosts
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5
# DB_POOL_TIMEOUT_S=5.0

# --- Provider keys (secrets) ------------------------------------------------------------------
# GEMINI_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=

# --- Models (pinned IDs, verified against provider docs when first used; no "latest" aliases) ---
# The embedding model has a default; the generator, Groq, judge and rerank models have none: set them from the pinned
# IDs in the comments below (the rerank model is pinned in the Rerank block, PRD D55).
# EMBEDDING_MODEL=gemini-embedding-001  # verified 2026-09-26; a different model is a new index version
# EMBEDDING_DIM=768                # must match the active index version
# Embedding limits: defaults are the gemini-embedding-001 free tier (AI Studio, 2026-09-26).
# EMBEDDING_BATCH_SIZE=100         # texts per API call; the API allows at most 100; <= EMBEDDING_RPM
# EMBEDDING_RPM=100                # counts texts, not calls: each text in a batch is one request
# EMBEDDING_TPM=30000              # paced with tiktoken estimates; 429s are retried
# EMBEDDING_MAX_INPUT_TOKENS=2048  # longer texts fail before any call; must be <= EMBEDDING_TPM
# EMBEDDING_MAX_RETRIES=5          # per batch, on 429 / 5xx / timeout (a daily-quota 429 is final)
# EMBEDDING_MAX_RETRY_WAIT_S=60.0  # a server-given wait over this stops the run (it is never shortened)
# EMBEDDING_TIMEOUT_S=30.0
# GENERATOR_PROVIDERS=gemini,groq  # ordered router list; eval uses a single provider; "fake" is the canned stub for smoke runs, judge included (refused in prod). With the router (Phase 7) only the first entry must be buildable; a later one missing its key or model is skipped with a warning (D57)
# GEMINI_MODEL=                    # pinned: gemini-3.5-flash-lite (PRD D46, verified 2026-10-06)
# GROQ_MODEL=                      # pinned: openai/gpt-oss-120b (PRD D48, verified 2026-10-08); fallback generator (Phase 7)
# JUDGE_MODEL=                     # pinned: openai/gpt-oss-120b (PRD D48, verified 2026-10-08); its provider (Groq) must differ from the eval generator's (Gemini)
# GEMINI_THINKING_LEVEL=minimal   # minimal | low | medium | high (Gemini 3.x has a level, not a token budget)
# GROQ_REASONING_EFFORT=low       # low | medium | high (openai/gpt-oss-120b); reasoning tokens are billed as output and use the 8K TPM of the free plan
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=800
# LLM_TIMEOUT_S=12.0               # each generation attempt
# EVAL_LLM_TIMEOUT_S=40.0          # eval only (APP_ENV=eval): the timeout of one generator or judge call, in place of LLM_TIMEOUT_S; not part of the eval cache key
# Eval mode (APP_ENV=eval) needs one generator provider that is not groq (GENERATOR_PROVIDERS=gemini) and LLM_TEMPERATURE=0, and refuses to start otherwise.
# The promptfoo harness (eval/promptfoo/, Tech §15.3) forces APP_ENV=eval and defaults GENERATOR_PROVIDERS to gemini. Export GENERATOR_PROVIDERS=fake (and a blank GEMINI_API_KEY, so a question missing from the embedding cache fails instead of calling the API) for a run with no network: the judge is then a canned stub too.
# The loader of that harness also reads the shell variable EVAL_QUESTION_IDS (golden ids, e.g. q003,q045) to run a few questions; it is not a setting.
# EVAL_MAX_TOTAL_WAIT_S=120.0      # eval only: most seconds one LLM call may spend waiting out per-minute 429s (Retry-After) and transient 5xx, together; a daily quota is raised at once
# EVAL_UNAVAILABLE_RETRIES=4       # eval only: retries of a transient 5xx (e.g. Gemini 503 "high demand"), within EVAL_MAX_TOTAL_WAIT_S; 0 turns them off, at most 10
# EVAL_UNAVAILABLE_WAIT_S=5.0      # eval only: the first 5xx wait in seconds, doubling each retry (5, 10, 20, 40 = 75 s)
# JUDGE_MAX_OUTPUT_TOKENS=800      # eval only: output cap of one judge call (Groq's reasoning tokens count inside it); its own setting, so a moved LLM_MAX_OUTPUT_TOKENS keeps the cached verdicts

# --- Provider router and circuit breaker (Tech §10, PRD D57) ----------------------------------
# The breaker's state is in memory, per function instance and per provider (no database). All values are seconds except the threshold.
# BREAKER_RATE_LIMIT_OPEN_S=60.0   # a per-minute 429 with no Retry-After opens the breaker this long
# BREAKER_QUOTA_OPEN_S=900.0       # a daily-quota 429 whose reset cannot be derived (Gemini: midnight Pacific; Groq: its own Retry-After) opens it this long, then one half-open trial
# BREAKER_FAILURE_THRESHOLD=3      # this many consecutive timeouts or 5xx ... (at least 1)
# BREAKER_FAILURE_WINDOW_S=60.0    # ... within this window ...
# BREAKER_FAILURE_OPEN_S=30.0      # ... open the breaker this long
# BREAKER_MAX_RETRY_AFTER_S=3600.0 # the longest provider-supplied Retry-After honored; a longer one is cut to this, and the half-open trial re-checks the provider. Not applied to a derived reset (midnight Pacific)

# --- Rerank -----------------------------------------------------------------------------------
# RERANK_PROVIDER=none             # none | cohere. A Cohere Trial key may not be used in production (1,000 calls a month, 10 Rerank requests a minute): the deployed demo keeps none (PRD D55)
# RERANK_MODEL=                    # pinned: rerank-v4.0-pro (PRD D55, verified 2026-10-12); fallback rerank-v4.0-fast. Unverified: that the Trial key accepts it, until the first real call
# RERANK_DAILY_CAP=30              # rerank calls a day, an atomic reserve in daily_usage (0 = no rerank at all); 31 days at 30 = 930 of the Trial's 1,000 a month, a key that dev and evals share. Not applied when APP_ENV=eval (Tech §8)
# RERANK_TIMEOUT_S=3.0             # the rerank stage of /v1/ask: one attempt, no retry, no sleep; a timeout degrades to the RRF order. Also applies in eval mode (Tech §8)
# EVAL_RERANK_MIN_INTERVAL_S=7.0   # eval only (grounded eval retrieval --config hybrid_rerank, APP_ENV=eval): least seconds between two LIVE rerank calls, so a run stays under the Trial key's 10 requests a minute; cache hits are not delayed; 0 = no pacing. The request path never sleeps (Tech §8)
# (With RERANK_PROVIDER=cohere the adapter needs RERANK_MODEL and COHERE_API_KEY and refuses to be built without them, Tech §4.)

# --- Chunking (changing any of these means a new index version) -------------------------------
# CHUNK_MAX_TOKENS=450
# CHUNK_OVERLAP_TOKENS=50          # between parts of one split section; must be < CHUNK_MAX_TOKENS
# CHUNK_MIN_TOKENS=40              # smaller sections merge into their first child or a sibling
# TOKENIZER_ENCODING=o200k_base    # tiktoken encoding for approximate sizing

# --- Retrieval --------------------------------------------------------------------------------
# K_DENSE=20
# K_FTS=20
# K_FUSED=40
# K_CONTEXT=5
# RRF_K=60
# ACTIVE_INDEX_TTL_S=300.0         # how long the request path keeps the active index version before re-reading it
# QUERY_EMBEDDING_CACHE_SIZE=256   # prod only: in-memory LRU of question vectors (dev/eval use SQLite)
# QUERY_EMBEDDING_TIMEOUT_S=3.0    # /v1/ask embed stage: one attempt, no retry, no sleep
# RETRIEVAL_TIMEOUT_S=2.0          # /v1/ask retrieval stage (search + context): 504 deadline_exceeded after this; not in eval mode (D54a)

# --- Confidence (Tech §9.8) -------------------------------------------------------------------
# CONFIDENCE_W_RETRIEVAL=0.40      # weights: relative importance of each signal (defaults sum to 1.0)
# CONFIDENCE_W_AGREEMENT=0.25
# CONFIDENCE_W_CITATIONS=0.20
# CONFIDENCE_W_SELF=0.15           # LLM self-report; at most 0.6, and its *share* is checked too (Tech §9.8)
# CONFIDENCE_W_RERANK=0.0          # stays 0 until Phase 6 measures the rerank lift
# CONFIDENCE_UNCITED_CAP=0.2       # most a claim without a valid citation can score; at most 0.2

# --- Protection -------------------------------------------------------------------------------
# Demo values (PRD D31, 5.01): 5 per minute, 20 per day per IP hash, 300 LLM calls per UTC day.
# RATE_LIMIT_PER_MIN=5             # per client (IP hash), Postgres fixed windows (Tech §12); off in eval mode
# RATE_LIMIT_PER_DAY=20
# DAILY_LLM_BUDGET=                # unset = no cap in dev/test; required in prod (5.05). Off in eval mode. Demo: 300, below the 500 RPD of gemini-3.5-flash-lite, which the CI evals share
# ANSWER_CACHE_TTL_DAYS=29         # at most 29: the daily job deletes user text at 29 days (DB §9)
# PROXY_SHARED_SECRET=             # random 32+ bytes; required in prod
# IP_HASH_SECRET=                  # random 32+ bytes; required in prod. Unset in dev: ip_hash is NULL and requests are not rate limited
# ALLOW_DIRECT_API=false           # true only in local dev (curl without X-Proxy-Secret); must be false in prod
# REQUEST_DEADLINE_S=25.0          # /v1/ask answers 504 deadline_exceeded after this; not in eval mode (5.08). Below the backend maxDuration (30) and the proxy timeout (35): Tech §18

# --- Paths and corpus -------------------------------------------------------------------------
# CACHE_DIR=.cache                # relative paths are taken from the repo root
# FASTAPI_REF=0.141.1              # pinned FastAPI tag for the corpus (commit 95f8322e)
