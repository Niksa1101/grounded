# Server-only settings of the Next.js Route Handlers (Tech §18). Copy to `.env.local`.
# Never prefix these with NEXT_PUBLIC_: that would put them in the browser bundle.
BACKEND_URL=http://127.0.0.1:8000
# Must equal the backend's PROXY_SHARED_SECRET. Generate one: openssl rand -hex 32
PROXY_SHARED_SECRET=
