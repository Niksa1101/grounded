{
  "openapi": "3.1.0",
  "info": {
    "title": "Grounded",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Process is up. Touches nothing else, so the keepalive ping never depends on the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Database reachable, schema present and an index version active.\n\nQuerying ``index_versions`` doubles as a \"migrations applied\" check. Without an active index\n``/v1/ask`` cannot retrieve anything, so that is a readiness failure too (503, with\n``database: ok``).",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ask": {
      "post": {
        "tags": [
          "ask"
        ],
        "summary": "Ask",
        "operationId": "ask_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "insufficient_context"
            ],
            "title": "Status"
          },
          "answer_markdown": {
            "type": "string",
            "title": "Answer Markdown"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "follow_up_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Follow Up Questions"
          },
          "min_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Confidence"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "status",
          "answer_markdown",
          "claims",
          "citations",
          "follow_up_questions",
          "min_confidence",
          "meta"
        ],
        "title": "AskResponse"
      },
      "Citation": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N"
          },
          "chunk_id": {
            "type": "integer",
            "title": "Chunk Id"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "breadcrumb": {
            "type": "string",
            "title": "Breadcrumb"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          }
        },
        "type": "object",
        "required": [
          "n",
          "chunk_id",
          "url",
          "title",
          "breadcrumb",
          "snippet"
        ],
        "title": "Citation"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Citations"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "confidence_components": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Confidence Components"
          }
        },
        "type": "object",
        "required": [
          "text",
          "citations",
          "confidence",
          "confidence_components"
        ],
        "title": "Claim"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "unauthorized",
              "rate_limited",
              "budget_exhausted",
              "validation_failed",
              "provider_unavailable",
              "deadline_exceeded",
              "internal_error"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retry_after_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After S"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Meta": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          },
          "rerank_used": {
            "type": "boolean",
            "title": "Rerank Used"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "index_version": {
            "type": "string",
            "title": "Index Version"
          },
          "retrieval_config_hash": {
            "type": "string",
            "title": "Retrieval Config Hash"
          },
          "latency_ms": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Latency Ms"
          },
          "tokens": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Tokens"
          },
          "shadow_cost_usd": {
            "type": "number",
            "title": "Shadow Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "provider",
          "model",
          "fallback_used",
          "cache_hit",
          "rerank_used",
          "prompt_version",
          "index_version",
          "retrieval_config_hash",
          "latency_ms",
          "tokens",
          "shadow_cost_usd"
        ],
        "title": "Meta"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Database"
          },
          "active_index_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Index Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "active_index_version"
        ],
        "title": "ReadinessResponse"
      }
    }
  }
}
